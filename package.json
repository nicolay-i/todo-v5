{
  "name": "todo-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start_local": "next start",
    "check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "start": "node .next/standalone/server.js",
    "deploy": "npm i && npm run mode:prod && node scripts/deploy-script.js",
    "mode:dev": "node scripts/switch-db.js dev && prisma migrate dev",
    "mode:prod": "node scripts/switch-db.js prod && prisma migrate dev",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "task": "node scripts/task.js",
    "task:clean": "node scripts/task-clean.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@tinymce/tinymce-react": "^6.3.0",
    "dotenv": "^17.2.2",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "tinymce": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "archiver": "^7.0.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "graceful-fs": "^4.2.11",
    "postcss": "8.4.49",
    "prisma": "^6.16.3",
    "tailwindcss": "3.4.16",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  }
}
