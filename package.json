{
  "name": "todo-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start_local": "next start",
    "check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "start": "node .next/standalone/server.js",
    "deploy": "npm i && npm run mode:prod && node scripts/deploy-script.js",
    "mode:dev": "node scripts/switch-db.js dev && prisma migrate dev",
    "mode:prod": "node scripts/switch-db.js prod && prisma migrate dev",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "task": "node scripts/task.js",
    "task:clean": "node scripts/task-clean.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.1.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^17.2.3",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "next": "16.0.7",
    "pg": "^8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-icons": "^5.5.0",
    "tinymce": "^8.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "archiver": "^7.0.1",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.7",
    "graceful-fs": "^4.2.11",
    "postcss": "8.5.6",
    "prisma": "^7.1.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  }
}
