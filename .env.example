# Файл примеров переменных окружения
# Скопируйте этот файл в .env и настройте под свои нужды

############################################################
# РЕЖИМ РАЗРАБОТКИ (SQLite)
############################################################
# Используется локальный файл БД. Структура миграций отделена:
#  - migrations директория для SQLite: prisma/migrations-sqlite
#  - при переключении скрипт обновит generator client -> migrations = "prisma/migrations-sqlite"
# Шаги:
# 1. Раскомментируйте DATABASE_URL ниже
# 2. Выполните: pnpm mode:dev  (переключит schema.prisma и выполнит prisma migrate dev)
# 3. Либо для быстрого прототипирования без миграций: pnpm db:push

# DATABASE_URL="file:./dev.db"

############################################################
# РЕЖИМ PRODUCTION (PostgreSQL)
############################################################
# Миграции для PostgreSQL хранятся отдельно:
#  - prisma/migrations
# При переключении: generator client -> migrations = "prisma/migrations"
# Шаги:
# 1. Раскомментируйте строки ниже и укажите верные креды
# 2. Выполните: pnpm mode:prod (переключит schema.prisma на PostgreSQL и выполнит prisma migrate dev)
# 3. Для применения уже собранных миграций в CI/CD можно использовать: npx prisma migrate deploy

# DATABASE_URL="postgresql://user:password@localhost:5432/todo_app?schema=public"
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/todo_app_shadow?schema=public"

############################################################
# ПРИМЕЧАНИЯ
############################################################
# - Скрипт scripts/switch-db.js автоматически:
#     * Меняет datasource между SQLite/PostgreSQL
#     * Обновляет migrations путь в generator client
# - Не редактируйте вручную эти части schema.prisma — они будут перезаписаны.
# - Для генерации нового клиента после смены режима prisma migrate dev уже запускается внутри mode:*.
# - SHADOW_DATABASE_URL обязателен для корректной работы миграций в PostgreSQL.
# - Если нужна только синхронизация без миграций: используйте pnpm db:push (обычно только в dev c SQLite).
# - Для CI/CD: используйте prisma migrate deploy с PostgreSQL.

