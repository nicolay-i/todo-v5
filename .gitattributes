# Унификация окончания строк
* text=auto eol=lf

# TypeScript / JS как текст
*.ts text diff
*.tsx text diff
*.js text diff
*.jsx text diff
*.d.ts text diff

# Prisma schema как текст
prisma/schema.prisma text diff
src/generated/prisma/schema.prisma text diff

# Бинарные движки Prisma — не показывать diff
src/generated/prisma/*.node binary -diff
src/generated/prisma/*.wasm binary -diff
src/generated/prisma/libquery_engine-* binary -diff
src/generated/prisma/query_engine-* binary -diff

# Package manifests
package.json text eol=lf
pnpm-lock.yaml text eol=lf -diff

# Архивы и артефакты
*.zip binary
*.tar binary
*.gz binary

# Изображения
*.png binary
*.jpg binary
*.jpeg binary
*.svg text
