generator client {
  provider      = "prisma-client-js"
  // AUTO: path managed by scripts/switch-db.js
  migrations = "prisma/migrations-sqlite"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ⚠️  ВАЖНО: Не редактируйте datasource блок вручную!
// Используйте команды для переключения между БД:
// - pnpm db:dev  (SQLite для разработки)
// - pnpm db:prod (PostgreSQL для production)
// Скрипт автоматически обновит блок между маркерами ниже.

// DATASOURCE_START - Не удаляйте эту строку, используется для автоматической замены
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}
// DATASOURCE_END - Не удаляйте эту строку, используется для автоматической замены

model Todo {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  completedAt DateTime?
  pinned    Boolean  @default(false)
  position  Int
  parentId  String?
  parent    Todo?    @relation("TodoChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Todo[]   @relation("TodoChildren")
  pinnedIn  PinnedTodo[]
  tags      Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PinnedList {
  id        String       @id @default(cuid())
  title     String
  position  Int
  isPrimary Boolean      @default(false)
  isActive  Boolean      @default(false)
  todos     PinnedTodo[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model PinnedTodo {
  id           Int        @id @default(autoincrement())
  pinnedListId String
  todoId       String
  position     Int

  pinnedList PinnedList @relation(fields: [pinnedListId], references: [id], onDelete: Cascade)
  todo       Todo       @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([pinnedListId, todoId])
  @@index([pinnedListId, position])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  position  Int      @default(0)
  isSystem  Boolean  @default(false)
  todos     Todo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
